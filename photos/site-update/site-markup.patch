+/* A .ph frame holding a real photo: keep the frame's aspect ratio, drop the
+   empty-state hatching, and let the picture fill it edge to edge. */
+.ph.has-photo::before { display: none; }
+.ph.has-photo > picture { position: absolute; inset: 0; display: block; }
+.ph.has-photo > picture img { width: 100%; height: 100%; object-fit: cover; display: block; }
+
