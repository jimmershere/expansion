
# Generated web assets (rebuild with scripts/optimize-photos.py)
photos/web/*
!photos/web/.gitkeep
__pycache__/

# Raw Facebook pull (gallery-dl output + metadata). Large, and these are
# customer vehicle photos -- this repo is public, so the raw archive stays
